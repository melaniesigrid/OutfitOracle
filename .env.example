# Outfit Oracle — environment variables
# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ── Development (direct API access) ──────────────────────────────────────────
# Used when EXPO_PUBLIC_PROXY_URL is not set.
# WARNING: this key is bundled into the JS bundle — anyone who unpacks
# the IPA can read it. Use only for local development; rotate before sharing.
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...

# ── Production (recommended) ──────────────────────────────────────────────────
# Deploy cloudflare-worker/ and set this to your Worker URL.
# When set, the app calls the proxy instead of the Anthropic API directly.
# The API key lives only in the Worker secret (never in the app bundle).
EXPO_PUBLIC_PROXY_URL=https://outfit-oracle-proxy.<your-subdomain>.workers.dev

# ── Analytics (optional) ──────────────────────────────────────────────────────
# PostHog project API key — get it from posthog.com (free tier: 1M events/month)
# Events are no-op when this key is not set.
EXPO_PUBLIC_POSTHOG_KEY=phc_...

# ── Editorial image generation (optional) ────────────────────────────────────
# fal.ai API key — create one at fal.ai/dashboard/keys
# Generates a cinematic editorial photograph for each oracle verdict (FLUX Pro).
# This key is bundled client-side; set a monthly spend cap in the fal.ai dashboard
# (~$0.05–0.08 per image). Image generation is silently disabled when not set.
EXPO_PUBLIC_FAL_KEY=fal-...

# ── Outfit imagery (optional) ────────────────────────────────────────────────
# Pexels API key — free tier: 200 req/hr, no attribution required for apps.
# Create one at pexels.com/api/new. Enables 76×76 photo thumbnails on each
# outfit item card. Images are cached per session in memory. When unset,
# cards render without images and the feature is fully silent.
EXPO_PUBLIC_PEXELS_KEY=

# ── Crash reporting (recommended before external users) ───────────────────────
# Sentry DSN — create a React Native project at sentry.io (free tier: 5k errors/month)
# Crash reporting is disabled in dev and no-ops when this key is not set.
# After setting, run: npx @sentry/wizard@latest -s -i reactNative  (one-time native setup)
EXPO_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
