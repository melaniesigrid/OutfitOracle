{
  "expo": {
    "name": "Outfit Oracle",
    "slug": "outfit-oracle",
    "version": "1.3.0",
    "newArchEnabled": true,
    "orientation": "portrait",
    "scheme": "outfitoracle",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F6",
    "icon": "./src/logo-dark.png",
    "splash": {
      "image": "./src/logo-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF9F6"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.melaniesigrid.outfitoracle",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "outfitoracle",
              "com.melaniesigrid.outfitoracle",
              "com.googleusercontent.apps.5567358159392-e7me79n0acj4oh3hokou8hvip0hdvmvl"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/logo-light.png",
        "backgroundColor": "#FAF9F6"
      },
      "package": "com.melaniesigrid.outfitoracle"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Outfit Oracle uses your location to give you a personalised outfit recommendation for where you are right now."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "outfitoracle"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/logo-dark.png",
          "color": "#FAF9F6",
          "sounds": []
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {}
  }
}
